# As variáveis do CX Hub (revisado em 20/10/2026). Copie para .env e preencha.
# O arquivo .env NUNCA vai para o Git (está no .gitignore). Na Vercel, cada uma é uma
# variável de ambiente do tipo "Sensitive" (o valor não aparece de novo depois de salvo).

# ---- Públicas: vão para o navegador (são feitas para isso; só funcionam dentro das regras do banco)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- Do servidor: NUNCA vão para o navegador
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# A chave com acesso total ao banco. Se vazar: gerar uma nova no Supabase (API Keys) e trocar aqui.
SUPABASE_SERVICE_ROLE_KEY=

# A tarefa agendada da manhã (8h): a Vercel envia este segredo; sem ele, o endereço responde 401.
CRON_SECRET=
# O endereço do site, nos links das mensagens do Slack.
QUALITYHUB_URL=

# Intercom (só leitura: as conversas, os tickets e os contatos).
INTERCOM_ACCESS_TOKEN=
# Opcional: outra região do Intercom (o padrão é https://api.intercom.io).
INTERCOM_API_BASE=

# Notion (só leitura: a Flukepédia).
NOTION_TOKEN=

# A IA da pré-avaliação (a Anthropic). Aceita os dois nomes.
ANTHROPIC_API_KEY=
API_ANTHROPIC=

# Google (só leitura: a planilha dos indicadores). O JSON inteiro da conta de serviço, numa linha.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Slack: o robô dos avisos da qualidade (publica no canal da qualidade).
SLACK_BOT_TOKEN=
SLACK_CANAL_QUALIDADE=
# Slack: o robô da Central de Turnos (publica no canal da escala).
SLACK_TURNOS_TOKEN=
SLACK_CANAL_ESCALA=
# Slack: o robô "CX Hub" do mural e das instabilidades (só lê) e o segredo de assinatura dos avisos dele.
SLACK_MURAL_TOKEN=
SLACK_SIGNING_SECRET=
# Opcionais: outros canais (os padrões são o #cx_mural e o #instabilidade).
SLACK_CANAL_MURAL=
SLACK_CANAL_INSTABILIDADE=
