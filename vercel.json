{
  "crons": [
    {
      "path": "/api/avisos-contestacoes",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/ler-planilha",
      "schedule": "0 13 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(assets|fonts|capas)/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://zugwegvitdqkkeqttuez.supabase.co; font-src 'self' data:; connect-src 'self' https://zugwegvitdqkkeqttuez.supabase.co wss://zugwegvitdqkkeqttuez.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        }
      ]
    },
    {
